# --- DATABASE CONFIGURATION ---
# Replace placeholders with your local Postgres credentials.
# For docker-compose: nextjs_user / nextjs_password / parking_dash
# Note: Use sslmode=disable for local development
DATABASE_URL="postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DB_NAME?sslmode=disable"
# Same URL for auth/seed (or set POSTGRES_URL if different)
POSTGRES_URL="postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DB_NAME?sslmode=disable"

# --- AUTHENTICATION ---
# Generate a secret using: `openssl rand -base64 32`
AUTH_SECRET="your-secret-key-here"
AUTH_URL="http://localhost:3000/api/auth"
# Site URL (for credential verification callback); use your dev URL
NEXTAUTH_URL="http://localhost:3000"

# --- GRPC CONFIGURATION (Optional) ---
# The port your Go Dashboard Service will listen on
DASHBOARD_PORT=50051