# --- DATABASE CONFIGURATION ---
# Replace placeholders with your local Postgres credentials
# Note: Use sslmode=disable for local Go development
DATABASE_URL="postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DB_NAME?sslmode=disable"

# --- AUTHENTICATION ---
# Generate a secret using: `openssl rand -base64 32`
AUTH_SECRET="your-secret-key-here"
AUTH_URL="http://localhost:3000/api/auth"

# --- GRPC CONFIGURATION (Optional) ---
# The port your Go Dashboard Service will listen on
DASHBOARD_PORT=50051