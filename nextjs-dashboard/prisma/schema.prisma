// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Box {
  id Int @id @default(autoincrement())
  boxId Int @unique @map("box_id")
  x1 Int
  y1 Int
  x2 Int
  y2 Int
  isCalibration Boolean @default(true) @map("is_calibration")
  isLocked Boolean @default(false) @map("is_locked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  snapshots BoxSnapshot[]

  @@map("boxes")
  @@index([boxId])
  @@index([isCalibration, isLocked])
}

model BoxSnapshot {
  id Int @id @default(autoincrement())
  boxId Int @map("box_id")
  x1 Int
  y1 Int
  x2 Int
  y2 Int
  isCalibration Boolean @default(true) @map("is_calibration")
  isLocked Boolean @default(false) @map("is_locked")
  observedAt DateTime @default(now()) @map("observed_at")
  box Box @relation(fields: [boxId], references: [boxId])

  @@map("box_snapshots")
  @@index([boxId, observedAt])
}
