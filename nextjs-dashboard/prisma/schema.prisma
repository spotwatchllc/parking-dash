generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Parking spot bounding box with availability status
// Format: {id, coordinates: [[x1,y1], [x2,y2], [x3,y3], [x4,y4]], availability: 0/1}
model Box {
  id           Int      @id @default(autoincrement())

  imageId      Int      @map("image_id")     // which camera/image template this belongs to
  boxId        Int      @map("box_id")       // box index within that image
  
  // Four corner coordinates (preserved from first detection)
  x1           Int
  y1           Int
  x2           Int
  y2           Int
  x3           Int
  y3           Int
  x4           Int
  y4           Int
  
  availability Int      @default(0)              // 0 = available, 1 = occupied
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("boxes")
  // Composite unique key: boxId is unique *within* an imageId
  @@unique([imageId, boxId])
  @@index([imageId])
}

// User-saved parking spots (user_id from external users table, not Prisma)
model SavedSpot {
  id        Int    @id @default(autoincrement())
  userId    String @map("user_id")   // UUID from users table
  imageId   Int    @map("image_id")
  boxId     Int    @map("box_id")
  name      String?                  // optional label e.g. "Work spot"
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, imageId, boxId])
  @@index([userId])
  @@map("saved_spots")
}
