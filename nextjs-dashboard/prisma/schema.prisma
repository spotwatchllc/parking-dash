generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

// Parking spot bounding box with availability status
// Format: {id, coordinates: [[x1,y1], [x2,y2], [x3,y3], [x4,y4]], availability: 0/1}
model Box {
  id           Int      @id @default(autoincrement())
  boxId        Int      @unique @map("box_id")  // External box ID from TTN
  
  // Four corner coordinates (preserved from first detection)
  x1           Int
  y1           Int
  x2           Int
  y2           Int
  x3           Int
  y3           Int
  x4           Int
  y4           Int
  
  availability Int      @default(0)              // 0 = available, 1 = occupied
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("boxes")
  @@index([boxId])
}
